# Database Configuration
# Local development (default SQLite):
DATABASE_URL=sqlite:///./urban_ventures.db

# Production PostgreSQL example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/urban_ventures_db

# Security & JWT Token
SECRET_KEY=urbanventures-super-secret-jwt-key-2026-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment
ENVIRONMENT=development
